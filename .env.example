# OAuth 2 application registered on openstreetmap.org (My Account → OAuth 2 applications):
# - redirect URI: <base URL>/callback, e.g. http://127.0.0.1:8000/callback for local development
# - confidential application, permissions: read_prefs, write_api
OSM_CLIENT=
OSM_SECRET=

# Source of the relation surroundings: overpass (default) or osm (OpenStreetMap API map calls)
# DOWNLOAD_RELATION_SOURCE=overpass

# Optional
# OVERPASS_API_INTERPRETER=https://overpass-api.de/api/interpreter
# SENTRY_DSN=
# WEBSITE=https://github.com/Zaczero/osm-relatify

# Local development without nix-shell (shell.nix sets both itself).
# TEST_ENV allows the login cookies over plain http, SSL_CERT_FILE is the system CA bundle that utils.py requires.
# TEST_ENV=1
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
